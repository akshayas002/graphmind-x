# --- Secrets — never commit ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Testing / linting caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data (large/binary, regenerable from the pipeline — don't commit) ---
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Neo4j (docker-compose volumes, local DB files) ---
neo4j_data/
neo4j_logs/
*.db

# --- ML / RL artifacts (later weeks: model checkpoints, training logs) ---
*.pt
*.pth
*.ckpt
*.onnx
runs/
wandb/
mlruns/
checkpoints/

# --- Generated outputs (decks, reports, exports — regenerable) ---
outputs/
*.pptx
*.docx
*.xlsx
!requirements.txt

# --- Logs ---
*.log
logs/

# --- OS cruft ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Node (in case a future web UI phase adds one) ---
node_modules/
npm-debug.log*

# --- Misc ---
*.bak
*.tmp
.cache/