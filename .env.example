# Copy this file to .env and fill in real values. Never commit .env.

# Neo4j (matches docker-compose.yml defaults — change if you edit that file)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmindpass

# EPO Open Patent Services (OPS) — official, free (4 GB/month), covers Indian
# patent bibliographic + legal-status data via INPADOC. Note: IP India itself
# has NO public API (InPASS is a web-only, CAPTCHA-protected portal), so this
# is the practical free, structured route to Indian patent data.
#   1. Register at https://developers.epo.org (free, "Non-paying" tier)
#   2. Create an app under "My Apps" to get a Consumer Key + Consumer Secret
EPO_OPS_CONSUMER_KEY=your_consumer_key_here
EPO_OPS_CONSUMER_SECRET=your_consumer_secret_here

# CQL query fields: ti=title, ab=abstract, ta=title+abstract, pa=applicant,
# in=inventor, ic=IPC class, cpc=CPC class, pn=publication number, pd=pub date.
# pn=IN restricts to publications with an Indian publication number.
# NOTE: verify this restricts correctly for your query on Espacenet's
# "Advanced search" (worldwide.espacenet.com) before running a big pull —
# OPS's CQL indexing for country-prefix search has been finicky before.
EPO_COUNTRY_CODE=IN
PATENT_SEARCH_KEYWORD=solid-state battery

# How many patents to pull in the first ingestion pass (start small)
INGESTION_SAMPLE_SIZE=200

# --- Ollama (local LLM, zero cost) ---
# Install: https://ollama.com/download
# Then run once: ollama pull llama3.1
# (llama3.1:8b is a reasonable default for CPU-only machines; if it's too
# slow, try a smaller model like qwen2.5:3b-instruct and update below)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60

# Max rows any single Explorer-generated Cypher query can return
CYPHER_RESULT_LIMIT=100
